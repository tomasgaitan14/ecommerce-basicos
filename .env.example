# URL pública del sitio, para las etiquetas Open Graph (la preview del link al compartirlo).
# Opcional: en Vercel sale sola de VERCEL_PROJECT_PRODUCTION_URL. Sin ninguna de las dos se usa
# http://localhost:5173. Ejemplo: SITE_URL=https://basicos.com.ar
SITE_URL=

# Contenedor de Google Tag Manager. Opcional: sin esta variable el sitio no carga GTM (así quedan
# local, las previews y los tests). En Vercel va solo en Production. Para probar GTM en local,
# definila en .env.local. Ejemplo: GTM_ID=GTM-XXXXXXX
GTM_ID=
